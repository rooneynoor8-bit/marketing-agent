# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional - Meta (Facebook/Instagram) Ads: a System User token with ads_read permission
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Optional - Google Ads API (also: pip install google-ads)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Your MCC (manager) account id, if client accounts sit under it
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
